# ============================================================
# INDICATORS
# ============================================================

def calculate_rsi(prices: np.ndarray, period: int = 14) -> np.ndarray:
    """Wilder RSI on a 0–100 scale."""
    prices = np.asarray(prices, dtype=float)

    if len(prices) < period + 1:
        return np.full(len(prices), np.nan)

    deltas = np.diff(prices)
    gains = np.maximum(deltas, 0.0)
    losses = np.maximum(-deltas, 0.0)

    avg_gain = float(np.mean(gains[:period]))
    avg_loss = float(np.mean(losses[:period]))

    rsi = np.full(len(prices), np.nan)

    if avg_loss == 0:
        rsi[period] = 100.0
    else:
        rs = avg_gain / avg_loss
        rsi[period] = 100.0 - 100.0 / (1.0 + rs)

    for i in range(period + 1, len(prices)):
        avg_gain = ((avg_gain * (period - 1)) + gains[i - 1]) / period
        avg_loss = ((avg_loss * (period - 1)) + losses[i - 1]) / period

        if avg_loss == 0:
            rsi[i] = 100.0
        else:
            rs = avg_gain / avg_loss
            rsi[i] = 100.0 - 100.0 / (1.0 + rs)

    return rsi


def calculate_stochastic_rsi(
    prices: np.ndarray,
    period: int = 14,
    k_smooth: int = 3,
    d_smooth: int = 3,
):
    """
    Stochastic RSI %K and %D.

    Formula:
        StochRSI = (RSI - lowest RSI) / (highest RSI - lowest RSI) * 100
    """
    rsi = calculate_rsi(prices, period)
    s = pd.Series(rsi, dtype=float)

    rsi_min = s.rolling(period, min_periods=period).min()
    rsi_max = s.rolling(period, min_periods=period).max()

    denominator = rsi_max - rsi_min

    stoch = pd.Series(np.nan, index=s.index, dtype=float)
    valid = denominator != 0
    stoch.loc[valid] = ((s.loc[valid] - rsi_min.loc[valid])
                        / denominator.loc[valid]) * 100.0

    # If RSI has been flat for the entire lookback, use neutral 50.
    stoch.loc[(denominator == 0) & s.notna()] = 50.0

    k = stoch.rolling(k_smooth, min_periods=k_smooth).mean()
    d = k.rolling(d_smooth, min_periods=d_smooth).mean()

    return k.to_numpy(), d.to_numpy()


