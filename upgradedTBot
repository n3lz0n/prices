@dataclass
class BacktestConfig:
    exchange_id: str = "kraken"
    symbol: str = "XRP/USDT"
    timeframe: str = "4h"
    years: float = 3.0

    starting_capital: float = 1000.0

    # Allocate this fraction of available cash to each trade.
    position_size_pct: float = 0.10

    # Ignore dust-sized trades.
    min_trade_value: float = 5.0

    # Stochastic RSI
    stoch_rsi_period: int = 14
    k_smooth: int = 3
    d_smooth: int = 3
    oversold: float = 20.0
    overbought: float = 80.0

    # Risk management
    take_profit_pct: float = 5.0
    stop_loss_pct: float = 3.0

    # Trading frictions
    fee_pct: float = 0.10       # 0.10% per side
    slippage_pct: float = 0.05  # 0.05% per side

    # Conservative same-candle TP/SL assumption.
    stop_before_target_if_both_hit: bool = True

    # Benchmark
    include_buy_and_hold: bool = True

    # Data quality
    max_gap_multiple: float = 2.5


